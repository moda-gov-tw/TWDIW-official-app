# tester_config.txt - twdiw_tester 設定檔
#
# 用法:複製本檔到 c99 目錄並命名為 tester_config.txt,填入數位憑證皮夾QR Code反掃測試頁面產生的金鑰後執行 run.bat(或 ./twdiw_tester)。
#
# 規則:
#   - 每行 key=value;'#' 開頭為註解。
#   - 數位憑證皮夾QR Code反掃測試頁面取得的金鑰皆為 Base64,直接貼入 *_b64 欄位即可。
#   - 每把金鑰填 Base64(*_b64)或 hex(*_hex)其中一種即可,程式會自動換算另一種並印出。
#   - 兩種都填時,程式會檢查兩者是否為同一把金鑰,不一致即中止。
#   - hex 不分大小寫、不含空白或 0x 前綴。
#
# !! 本檔含私鑰,請僅使用測試金鑰,勿提交到版本庫或寄出 !!
# ---------------------------------------------------------------------------

# [1] 裝置私鑰(數位憑證皮夾QR Code反掃測試頁面管理員設定區「Curve25519 私鑰產生」的 privateKey,PKCS#8 DER,約 64 字元)
priv_b64=
priv_hex=

# [2] totpKey(數位憑證皮夾QR Code反掃測試頁面「TOTP 金鑰產生」)
totp_b64=
totp_hex=

# [3] hmacKey(數位憑證皮夾QR Code反掃測試頁面「HMAC 金鑰產生」)
hmac_b64=
hmac_hex=

# [4] (可選)驗證時間,Unix 秒。
#     留白 = 每次貼上 QR 時取本機時間(建議:數位憑證皮夾QR Code反掃測試頁面產生 QR 後 60 秒內貼上)。
#     卡在 TOTP 時,工具會自動掃描 now±120 秒並提示正確時刻。
now=
